import type { TrainRecord, TrainMove, TrainSet, Movement } from './types.uts'
import { todayKey } from './date.uts'

const KEY_RECORDS = 'xunji_records_v1'
const KEY_ACTIVE = 'xunji_active_v1'
export const DEFAULT_REST_TIME = 90

function normalizeSet(raw : TrainSet) : TrainSet {
	return {
		weight: raw.weight == null ? 0 : raw.weight,
		reps: raw.reps == null ? 0 : raw.reps,
		seconds: raw.seconds == null ? 0 : raw.seconds,
		done: raw.done == true,
		setType: raw.setType == null ? '' : raw.setType,
		unit: raw.unit == null ? 'kg' : raw.unit
	} as TrainSet
}

function normalizeMove(raw : TrainMove) : TrainMove {
	const sets : TrainSet[] = []
	if (raw.sets != null) {
		for (let i = 0; i < raw.sets.length; i++) {
			sets.push(normalizeSet(raw.sets[i]))
		}
	}
	return {
		key: raw.key == null ? '' : raw.key,
		name: raw.name == null ? '' : raw.name,
		category: raw.category == null ? '' : raw.category,
		exetype: raw.exetype == null ? 'weight' : raw.exetype,
		section: raw.section == null ? 'other' : raw.section,
		sets: sets,
		restTime: raw.restTime == null ? DEFAULT_REST_TIME : raw.restTime,
		oneSide: raw.oneSide == true
	} as TrainMove
}

export function normalizeRecord(raw : TrainRecord) : TrainRecord {
	const moves : TrainMove[] = []
	if (raw.moves != null) {
		for (let i = 0; i < raw.moves.length; i++) {
			moves.push(normalizeMove(raw.moves[i]))
		}
	}
	return {
		id: raw.id == null ? '' : raw.id,
		date: raw.date == null || raw.date.length == 0 ? todayKey() : raw.date,
		title: raw.title == null || raw.title.length == 0 ? '自由训练' : raw.title,
		note: raw.note == null ? '' : raw.note,
		start: raw.start == null ? 0 : raw.start,
		end: raw.end == null ? 0 : raw.end,
		moves: moves
	} as TrainRecord
}

export function loadRecords() : TrainRecord[] {
	const raw = uni.getStorageSync(KEY_RECORDS)
	if (raw == null || raw == '') {
		return []
	}
	const text = raw as string
	if (text.length == 0) {
		return []
	}
	const list = JSON.parse<TrainRecord[]>(text)
	if (list == null) {
		return []
	}
	const out : TrainRecord[] = []
	for (let i = 0; i < list.length; i++) {
		out.push(normalizeRecord(list[i]))
	}
	out.sort((a : TrainRecord, b : TrainRecord) : number => b.date.localeCompare(a.date))
	return out
}

export function saveRecords(records : TrainRecord[]) : void {
	uni.setStorageSync(KEY_RECORDS, JSON.stringify(records))
}

export function upsertRecord(record : TrainRecord) : void {
	const records = loadRecords()
	let found = false
	for (let i = 0; i < records.length; i++) {
		if (records[i].id == record.id) {
			records[i] = record
			found = true
			break
		}
	}
	if (!found) {
		records.push(record)
	}
	saveRecords(records)
}

export function removeRecord(id : string) : void {
	const records = loadRecords()
	const next : TrainRecord[] = []
	for (let i = 0; i < records.length; i++) {
		if (records[i].id != id) {
			next.push(records[i])
		}
	}
	saveRecords(next)
}

export function findRecord(id : string) : TrainRecord | null {
	const records = loadRecords()
	for (let i = 0; i < records.length; i++) {
		if (records[i].id == id) {
			return records[i]
		}
	}
	return null
}

export function recordsOfDate(date : string) : TrainRecord[] {
	const records = loadRecords()
	return records.filter((r : TrainRecord) : boolean => r.date == date)
}

export function recordCountByDate() : Map<string, number> {
	const records = loadRecords()
	const map = new Map<string, number>()
	records.forEach((r : TrainRecord) => {
		const old = map.get(r.date)
		map.set(r.date, (old == null ? 0 : (old as number)) + 1)
	})
	return map
}

export function newRecord() : TrainRecord {
	const now = new Date()
	const record : TrainRecord = {
		id: now.getTime().toString(),
		date: todayKey(),
		title: '自由训练',
		note: '',
		start: now.getTime(),
		end: 0,
		moves: []
	} as TrainRecord
	return record
}

export function newSet(weight : number, reps : number) : TrainSet {
	return {
		weight: weight,
		reps: reps,
		seconds: 0,
		done: false,
		setType: '',
		unit: 'kg'
	} as TrainSet
}

export function newMove(movement : Movement) : TrainMove {
	return {
		key: movement.id,
		name: movement.name,
		category: movement.category,
		exetype: movement.exetype,
		section: movement.section,
		sets: [newSet(0, 10)],
		restTime: DEFAULT_REST_TIME,
		oneSide: false
	} as TrainMove
}

export function loadActive() : TrainRecord | null {
	const raw = uni.getStorageSync(KEY_ACTIVE)
	if (raw == null || raw == '') {
		return null
	}
	const text = raw as string
	if (text.length == 0) {
		return null
	}
	const parsed = JSON.parse<TrainRecord>(text)
	if (parsed == null) {
		return null
	}
	return normalizeRecord(parsed)
}

export function saveActive(record : TrainRecord) : void {
	uni.setStorageSync(KEY_ACTIVE, JSON.stringify(record))
}

export function clearActive() : void {
	uni.removeStorageSync(KEY_ACTIVE)
}
