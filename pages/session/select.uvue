	}

	.side-item-active {
		background-color: #FFFFFF;
		border-top-left-radius: 10px;
		border-bottom-left-radius: 10px;
	}

	.side-text {
		font-size: 13px;
		color: #636366;
	}

	.side-text-active {
		font-size: 14px;
		font-weight: 700;
		color: #007AFF;
	}

	.list {
		flex: 1;
		height: 100%;
		display: flex;
		flex-direction: column;
		background-color: #FFFFFF;
		border-top-left-radius: 12px;
	}

	.move {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 12px 14px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F2F2F7;
	}

	.move-icon {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background-color: #F2F2F7;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.move-icon-on {
		background-color: #34C759;
	}

	.move-icon-text {
