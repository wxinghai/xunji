		color: #34C759;
	}

	.footer {
		padding: 10px 16px 16px 16px;
		padding-bottom: calc(16px + env(safe-area-inset-bottom));
		background-color: #FFFFFF;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E5E5EA;
	}

	.footer-btn {
		height: 48px;
		border-radius: 14px;
