<template>
	<view class="page">
		<view class="status-bar"></view>
		<scroll-view class="body" direction="vertical">
			<view class="date-wrap">
				<text class="date-text">{{dateText}}</text>
			</view>
			<view class="hairline-wrap">
				<view class="hairline"></view>
			</view>

			<view v-if="active != null || todayRecords.length > 0" class="section-head">
				<text class="section-title">今日训练</text>
			</view>

			<view v-if="active != null" class="train-card" @tap="openActive">
				<view class="card-left">
					<text class="card-title" :class="{ 'card-title-done': percentOf(active) >= 100 }">{{active.title}}</text>
					<view class="card-stats">
						<text class="stat-label">动作</text>
						<text class="stat-value">{{active.moves.length}}</text>
						<view class="stat-divider"></view>
						<text class="stat-label">组数</text>
						<text class="stat-value">{{setsOf(active)}}</text>
					</view>
				</view>
				<view class="card-right">
					<view v-if="percentOf(active) == 0" class="go-badge">
						<text class="go-text">GO!</text>
					</view>
					<text v-else class="pct-text">{{percentOf(active)}}%</text>
				</view>
			</view>

			<view v-for="item in todayRecords" :key="item.id" class="train-card" @tap="openTrain(item.id)">
				<view class="card-left">
					<text class="card-title" :class="{ 'card-title-done': percentOf(item) >= 100 }">{{item.title}}</text>
					<view class="card-stats">
						<text class="stat-label">动作</text>
						<text class="stat-value">{{item.moves.length}}</text>
						<view class="stat-divider"></view>
						<text class="stat-label">组数</text>
						<text class="stat-value">{{setsOf(item)}}</text>
					</view>
				</view>
				<view class="card-right">
					<view v-if="percentOf(item) == 0" class="go-badge">
						<text class="go-text">GO!</text>
					</view>
					<view v-else-if="percentOf(item) >= 100" class="card-right-done">
						<text class="time-text">{{durationOf(item)}}</text>
						<text class="time-sub">全部完成</text>
					</view>
					<text v-else class="pct-text">{{percentOf(item)}}%</text>
				</view>
			</view>

			<view v-if="active == null && todayRecords.length == 0" class="empty-card">
				<text class="empty-title">今天还没有训练</text>
				<text class="empty-sub">从动作库挑个动作开始</text>
				<view class="empty-btn" @tap="startTraining">
					<text class="empty-btn-text">开始训练</text>
				</view>
			</view>

			<view class="section-head">
				<text class="section-title">最近训练</text>
				<text class="section-more" @tap="goHistory">全部</text>
			</view>

			<view v-if="recent.length == 0" class="recent-empty">
				<text class="recent-empty-text">还没有训练记录</text>
			</view>

			<view v-for="item in recent" :key="item.id" class="recent-item" @tap="openTrain(item.id)">
				<view class="recent-date">
					<text class="recent-day">{{dayOf(item.date)}}</text>
					<text class="recent-month">{{monthOf(item.date)}}</text>
				</view>
				<view class="recent-main">
					<text class="recent-title">{{item.title}}</text>
					<text class="recent-sub">{{recordSub(item)}}</text>
				</view>
				<text class="recent-arrow">›</text>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="ts">
	import { todayKey, fullDateLabel } from '@/common/date.uts'
	import { loadRecords, loadActive, newRecord, saveActive, findRecord } from '@/common/storage.uts'
	import { trainPercent, recordSets, trainDuration, durationHM, recordVolume } from '@/common/calc.uts'
	import type { TrainRecord } from '@/common/types.uts'

	const dateText = ref(fullDateLabel())
	const active = ref<TrainRecord | null>(null)
	const todayRecords = ref<TrainRecord[]>([])
	const recent = ref<TrainRecord[]>([])

	onShow(() => {
		refresh()
	})

	function refresh() {
		const all = loadRecords()
		dateText.value = fullDateLabel()
		const tk = todayKey()
		todayRecords.value = all.filter((r : TrainRecord) : boolean => r.date == tk)
		active.value = loadActive()
		const top : TrainRecord[] = []
		for (let i = 0; i < all.length && top.length < 5; i++) {
			top.push(all[i])
		}
		recent.value = top
	}

	function percentOf(rec : TrainRecord) : number {
		return trainPercent(rec)
	}

	function setsOf(rec : TrainRecord) : number {
		return recordSets(rec)
	}

	function durationOf(rec : TrainRecord) : string {
		return durationHM(trainDuration(rec))
	}

	function startTraining() {
		const running = loadActive()
		if (running != null) {
			uni.navigateTo({ url: '/pages/session/index' })
			return
		}
		const rec = newRecord()
		saveActive(rec)
		uni.navigateTo({ url: '/pages/session/index' })
	}

	function openActive() {
		uni.navigateTo({ url: '/pages/session/index' })
	}

	function openTrain(id : string) {
		const rec = findRecord(id)
		if (rec == null) {
			return
		}
		const running = loadActive()
		if (running != null && running.id != id) {
			uni.showModal({
				title: '有未完成的训练',
				content: '继续查看会替换当前未完成的训练，确定吗？',
				confirmText: '继续',
				success: (res) => {
					if (res.confirm) {
						doOpenTrain(rec)
					}
				}
			})
			return
		}
		doOpenTrain(rec)
	}

	function doOpenTrain(rec : TrainRecord) {
		saveActive(rec)
		uni.navigateTo({ url: '/pages/session/index' })
	}

	function goHistory() {
		uni.switchTab({ url: '/pages/history/index' })
	}

	function dayOf(date : string) : string {
		if (date.length < 10) {
			return '--'
		}
		return date.substring(8, 10)
	}

	function monthOf(date : string) : string {
		if (date.length < 7) {
			return ''
		}
		return parseInt(date.substring(5, 7)).toString() + '月'
	}

	function recordSub(item : TrainRecord) : string {
		let text = item.moves.length.toString() + ' 个动作 · ' + recordSets(item).toString() + ' 组'
		const vol = Math.round(recordVolume(item))
		if (vol > 0) {
			text += ' · ' + vol.toString() + 'kg'
		} else {
			text += ' · ' + durationOf(item)
		}
		return text
	}
</script>

