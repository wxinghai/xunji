<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="cal-head">
			<text class="cal-arrow" @tap="prevMonth">‹</text>
			<view class="month-text-wrap">
				<text class="month-year">{{year}} 年</text>
				<text class="month-main">{{month}} 月</text>
			</view>
			<text class="cal-arrow" @tap="nextMonth">›</text>
			<text v-if="!isCurrentMonth" class="back-btn" @tap="backToCurrent">回到本月</text>
		</view>

		<view class="week-row">
			<text v-for="w in weekLabels" :key="w" class="week-cell" :style="cellStyle">{{w}}</text>
		</view>

		<scroll-view class="body" direction="vertical">
			<view class="days-wrap">
				<view v-for="c in cells" :key="c.key" class="day-cell"
					:class="{ 'day-cell-dim': !c.inMonth }" :style="cellStyle" @tap="pickDay(c)">
					<view class="day-badge"
						:class="{ 'day-badge-today': c.key == today, 'day-badge-selected': c.key == selected }">
						<text class="day-text" :class="{ 'day-text-white': c.key == today || c.key == selected }">{{c.day}}</text>
					</view>
					<view v-if="c.hasMark" class="bar-summary"
						:class="{ 'bar-summary-today': c.key == today }" :style="barStyle">
						<text class="bar-summary-text">{{c.volumeText}}</text>
					</view>
					<view v-if="c.hasMark && c.title.length > 0" class="bar-title" :style="barStyle">
						<text class="bar-title-text" :max-lines="3">{{c.title}}</text>
					</view>
				</view>
			</view>

			<view class="list-head">
				<text class="list-title">{{selectedLabel}}</text>
				<text class="list-count">{{dayRecords.length}} 次</text>
			</view>

			<view v-if="dayRecords.length == 0" class="empty">
				<text class="empty-text">这天没有训练记录</text>
			</view>

			<view v-for="item in dayRecords" :key="item.id" class="record">
				<view class="record-head" @tap="toggleExpand(item.id)">
					<view class="record-head-main">
						<text class="record-title">{{item.title}}</text>
						<text class="record-sub">{{recordSub(item)}}</text>
					</view>
					<text class="record-arrow">{{expandedId == item.id ? '⌄' : '›'}}</text>
				</view>

				<view v-if="expandedId == item.id" class="record-detail">
					<view v-for="mv in item.moves" :key="mv.key" class="detail-move">
						<text class="detail-name">{{mv.name}}</text>
						<view class="detail-sets">
							<text v-for="(s, si) in mv.sets" :key="si" class="detail-set">{{setText(s)}}</text>
						</view>
					</view>
					<view class="record-actions">
						<text class="delete-text" @tap="confirmDelete(item.id)">删除这次训练</text>
					</view>
				</view>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="ts">
	import { todayKey, dateKeyOf, daysInMonth, firstWeekday, formatDuration, pad2 } from '@/common/date.uts'
	import { loadRecords, recordsOfDate, removeRecord } from '@/common/storage.uts'
	import { buildMonthMarks, recordVolume, recordSets, trainPercent, trainDuration } from '@/common/calc.uts'
	import type { TrainRecord, TrainSet, DayMark } from '@/common/types.uts'

	type CalCell = {
		day : number
		inMonth : boolean
		key : string
		hasMark : boolean
		volumeText : string
		title : string
	}

	const W = uni.getWindowInfo().windowWidth
	const cellW = (W - 24) / 7
	const barW = (W - 32) / 7
	const weekLabels : string[] = ['日', '一', '二', '三', '四', '五', '六']
	const now = new Date()
	const year = ref(now.getFullYear())
	const month = ref(now.getMonth() + 1)
	const today = todayKey()
	const selected = ref(today)
	const marks = ref<Map<string, DayMark>>(new Map<string, DayMark>())
	const dayRecords = ref<TrainRecord[]>([])
	const expandedId = ref('')

	const cellStyle = computed<string>(() : string => {
		return 'width:' + cellW.toString() + 'px;height:92px;'
	})

	const barStyle = computed<string>(() : string => {
		return 'width:' + barW.toString() + 'px;'
	})

	const isCurrentMonth = computed<boolean>(() : boolean => {
		return year.value == now.getFullYear() && month.value == now.getMonth() + 1
	})

	const cells = computed<CalCell[]>(() : CalCell[] => {
		const y = year.value
		const m = month.value
		const first = firstWeekday(y, m)
		const total = daysInMonth(y, m)
		const prevY = m == 1 ? y - 1 : y
		const prevM = m == 1 ? 12 : m - 1
		const prevTotal = daysInMonth(prevY, prevM)
		const nextY = m == 12 ? y + 1 : y
		const nextM = m == 12 ? 1 : m + 1
		const arr : CalCell[] = []
		for (let i = first - 1; i >= 0; i--) {
			const d = prevTotal - i
			arr.push(makeCell(d, false, dateKeyOf(prevY, prevM, d)))
		}
		for (let d = 1; d <= total; d++) {
			arr.push(makeCell(d, true, dateKeyOf(y, m, d)))
		}
		let nd = 1
		while (arr.length < 42) {
			arr.push(makeCell(nd, false, dateKeyOf(nextY, nextM, nd)))
			nd += 1
		}
		return arr
	})

	const selectedLabel = computed<string>(() : string => {
		const key = selected.value
		if (key.length < 10) {
			return key
		}
		const m = parseInt(key.substring(5, 7))
		const d = parseInt(key.substring(8, 10))
		const date = new Date(parseInt(key.substring(0, 4)), m - 1, d)
		const weeks : string[] = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
		return m.toString() + '月' + d.toString() + '日 ' + weeks[date.getDay()]
	})

	onShow(() => {
		refresh()
	})

	function makeCell(day : number, inMonth : boolean, key : string) : CalCell {
		const mark = marks.value.get(key)
		let hasMark = false
		let volumeText = ''
		let title = ''
		if (mark != null) {
			const mk = mark as DayMark
			hasMark = true
			title = mk.title
			if (mk.volume > 0) {
				volumeText = Math.round(mk.volume).toString()
			} else {
				volumeText = mk.count.toString()
			}
		}
		return {
			day: day,
			inMonth: inMonth,
			key: key,
			hasMark: hasMark,
			volumeText: volumeText,
			title: title
		} as CalCell
	}

	function refresh() {
		const all = loadRecords()
		const monthKey = year.value.toString() + '-' + pad2(month.value)
		marks.value = buildMonthMarks(all, monthKey)
		dayRecords.value = recordsOfDate(selected.value)
	}

	function pickDay(c : CalCell) {
		selected.value = c.key
		expandedId.value = ''
		if (!c.inMonth) {
			year.value = parseInt(c.key.substring(0, 4))
			month.value = parseInt(c.key.substring(5, 7))
			refresh()
			return
		}
		dayRecords.value = recordsOfDate(c.key)
	}

	function prevMonth() {
		if (month.value == 1) {
			month.value = 12
			year.value -= 1
		} else {
			month.value -= 1
		}
		selectFirstOfMonth()
	}

	function nextMonth() {
		if (month.value == 12) {
			month.value = 1
			year.value += 1
		} else {
			month.value += 1
		}
		selectFirstOfMonth()
	}

	function selectFirstOfMonth() {
		selected.value = dateKeyOf(year.value, month.value, 1)
		expandedId.value = ''
		refresh()
	}

	function backToCurrent() {
		year.value = now.getFullYear()
		month.value = now.getMonth() + 1
		selected.value = today
		expandedId.value = ''
		refresh()
	}

	function toggleExpand(id : string) {
		if (expandedId.value == id) {
			expandedId.value = ''
		} else {
			expandedId.value = id
		}
	}

	function confirmDelete(id : string) {
		uni.showModal({
			title: '删除训练',
			content: '确定删除这次训练记录吗？',
			success: (res) => {
				if (res.confirm) {
					removeRecord(id)
					expandedId.value = ''
					refresh()
				}
			}
		})
	}

	function recordSub(item : TrainRecord) : string {
		let text = item.moves.length.toString() + ' 个动作 · ' + recordSets(item).toString() + ' 组 · ' + trainPercent(item).toString() + '%'
		const vol = Math.round(recordVolume(item))
		if (vol > 0) {
			text += ' · ' + vol.toString() + 'kg'
		}
		const dur = trainDuration(item)
		if (dur > 0) {
			text += ' · ' + formatDuration(dur)
		}
		return text
	}

	function setText(s : TrainSet) : string {
		if (s.setType == '热') {
			return '热'
		}
		if (s.weight > 0) {
			return s.weight.toString() + 'kg × ' + s.reps.toString()
		}
		return s.reps.toString() + ' 次'
	}
</script>

<style>
