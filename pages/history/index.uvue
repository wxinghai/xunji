	}

	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.days-wrap {
		padding-left: 12px;
		padding-right: 12px;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.day-cell {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.day-cell-dim {
		opacity: 0.5;
	}

	.day-badge {
		width: 25px;
