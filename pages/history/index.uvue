		margin-top: 1px;
		padding-left: 2px;
		padding-right: 2px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.bar-title-text {
		font-size: 8px;
		font-weight: 700;
		color: #FFFFFF;
		opacity: 0.9;
	}

	.list-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 18px 20px 8px 20px;
	}

	.list-title {
