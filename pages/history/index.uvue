	}

	.days-wrap {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 6px;
	}

	.day-cell {
		width: 14.28%;
		height: 46px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.day-inner {
		width: 38px;
		height: 38px;
		border-radius: 19px;
		display: flex;
		flex-direction: column;
