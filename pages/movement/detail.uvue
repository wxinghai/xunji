	.page {
		flex: 1;
		display: flex;
		flex-direction: column;
		background-color: #F2F2F7;
	}

	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.detail-gif {
		width: 100%;
		height: 220px;
		background-color: #FFFFFF;
	}

