		padding: 20px;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.hero-category {
		font-size: 12px;
		color: #007AFF;
		font-weight: 600;
	}

	.hero-name {
		font-size: 26px;
		font-weight: 700;
		color: #1C1C1E;
		margin-top: 8px;
	}

	.tag-row {
		display: flex;
		flex-direction: row;
		margin-top: 14px;
	}

	.tag {
		padding: 5px 10px;
		border-radius: 8px;
		background-color: #F2F2F7;
		margin-right: 8px;
	}

