<template>
	<view class="page">
		<scroll-view class="body" direction="vertical">
			<image v-if="gifUrl.length > 0" class="detail-gif" :src="gifUrl" mode="aspectFit" />
			<view class="hero">
				<text class="hero-category">{{moveCategory}}</text>
				<text class="hero-name">{{moveName}}</text>
				<view class="tag-row">
					<view class="tag">
						<text class="tag-text">{{typeText}}</text>
					</view>
					<view class="tag">
						<text class="tag-text">{{sectionText}}</text>
					</view>
					<view class="tag">
						<text class="tag-text">{{sceneText}}</text>
					</view>
				</view>
			</view>

			<view class="card">
				<text class="card-title">目标肌肉</text>
				<view class="muscle-row">
					<text class="muscle-label">主要</text>
					<text class="muscle-value">{{primaryText}}</text>
				</view>
				<view v-if="secondaryText.length > 0" class="muscle-row">
					<text class="muscle-label">辅助</text>
					<text class="muscle-value">{{secondaryText}}</text>
				</view>
			</view>

			<view class="card">
				<text class="card-title">动作信息</text>
				<view class="info-row">
					<text class="info-label">分类</text>
					<text class="info-value">{{moveCategory}}</text>
				</view>
				<view class="info-row">
					<text class="info-label">器械</text>
					<text class="info-value">{{sectionText}}</text>
				</view>
				<view class="info-row">
					<text class="info-label">训练类型</text>
					<text class="info-value">{{typeText}}</text>
				</view>
				<view class="info-row">
					<text class="info-label">适用场景</text>
					<text class="info-value">{{sceneText}}</text>
				</view>
			</view>

			<view class="card">
				<text class="card-title">别名</text>
				<text class="alias-text">{{aliasText}}</text>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>

		<view class="footer">
			<view class="add-btn" @tap="addToTraining">
				<text class="add-btn-text">加入当前训练</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { findMove, sectionLabel, exetypeLabel, gifOf } from '@/common/moves.uts'
	import { loadActive, newRecord, saveActive, newMove } from '@/common/storage.uts'
	import { todayKey } from '@/common/date.uts'
	import type { Movement, TrainRecord, TrainMove } from '@/common/types.uts'

	const move = ref<Movement | null>(null)
	const moveName = ref('')
	const moveCategory = ref('')
	const typeText = ref('')
	const sectionText = ref('')
	const sceneText = ref('')
	const primaryText = ref('')
	const secondaryText = ref('')
	const aliasText = ref('')
	const gifUrl = ref('')

	onLoad((options : OnLoadOptions) => {
		const raw = options['id']
		const id = raw == null ? '' : (raw as string)
		const m = findMove(id)
		if (m == null) {
			moveName.value = '未找到动作'
			return
		}
		move.value = m
		gifUrl.value = gifOf(m.id)
		moveName.value = m.name
		moveCategory.value = m.category
		typeText.value = exetypeLabel(m.exetype)
		sectionText.value = sectionLabel(m.section)
		sceneText.value = m.home_friendly ? '居家 / 健身房' : '健身房'
		primaryText.value = m.primary.length > 0 ? m.primary.join('、') : '未标注'
		secondaryText.value = m.secondary.join('、')
		const aliases : string[] = []
		for (let i = 0; i < m.aliases.length && aliases.length < 8; i++) {
			const a = m.aliases[i]
			if (a != m.name && a != m.id) {
				aliases.push(a)
			}
		}
		aliasText.value = aliases.length > 0 ? aliases.join(' / ') : '无'
		uni.setNavigationBarTitle({ title: m.name })
	})

	function addToTraining() {
		const m = move.value
		if (m == null) {
			return
		}
		let rec = loadActive()
		if (rec == null) {
			rec = newRecord()
			rec.date = todayKey()
		}
		let exists = false
		for (let i = 0; i < rec.moves.length; i++) {
			if (rec.moves[i].key == m.id) {
				exists = true
				break
			}
		}
		if (!exists) {
			rec.moves.push(newMove(m))
		}
		saveActive(rec)
		uni.showToast({
			title: exists ? '已在当前训练中' : '已加入当前训练',
			icon: 'none'
		})
		setTimeout(() => {
			uni.navigateBack({})
		}, 500)
	}
</script>

