		font-size: 11px;
		color: #636366;
	}

	.card {
		margin: 12px 16px 0 16px;
		padding: 16px;
		background-color: #FFFFFF;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
	}

	.card-title {
		font-size: 15px;
		font-weight: 700;
		color: #1C1C1E;
		margin-bottom: 10px;
	}

	.muscle-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		margin-top: 6px;
	}

	.muscle-label {
		width: 44px;
		font-size: 12px;
		color: #8E8E93;
	}

	.muscle-value {
		flex: 1;
		font-size: 14px;
		color: #3A3A3C;
	}

	.info-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 7px 0;
	}

	.info-label {
		font-size: 13px;
		color: #8E8E93;
	}

	.info-value {
		font-size: 13px;
		color: #3A3A3C;
	}

	.alias-text {
		font-size: 13px;
		color: #636366;
		line-height: 20px;
	}

	.bottom-space {
		height: 20px;
	}

	.footer {
		padding: 10px 16px 16px 16px;
		padding-bottom: calc(16px + env(safe-area-inset-bottom));
		background-color: #FFFFFF;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E5E5EA;
	}

	.add-btn {
		height: 48px;
		border-radius: 14px;
		background-color: #007AFF;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.add-btn-text {
		font-size: 16px;
		font-weight: 600;
		color: #FFFFFF;
	}
</style>
