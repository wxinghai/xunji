<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<text class="title">动作</text>
			<view class="search-box">
				<text class="search-icon">⌕</text>
				<input class="search-input" type="text" v-model="keyword" placeholder="搜索动作、部位、器械"
					placeholder-style="color:#8E8E93" confirm-type="search" />
				<text v-if="keyword.length > 0" class="search-clear" @tap="clearKeyword">×</text>
			</view>
		</view>

		<view class="content">
			<scroll-view class="side" direction="vertical" show-scrollbar="false">
				<view v-for="g in groups" :key="g.key" class="side-item"
					:class="{ 'side-item-active': g.key == category }" @tap="selectCategory(g.key)">
					<text class="side-text" :class="{ 'side-text-active': g.key == category }">{{g.label}}</text>
					<text class="side-count">{{g.count}}</text>
				</view>
			</scroll-view>

			<list-view class="list" direction="vertical" show-scrollbar="false">
				<list-item v-for="m in filtered" :key="m.id" class="move" @tap="openMove(m.id)">
					<view class="move-icon">
						<text class="move-icon-text">{{m.category.substring(0, 1)}}</text>
					</view>
					<view class="move-main">
						<text class="move-name">{{m.name}}</text>
						<text class="move-sub">{{moveSub(m)}}</text>
					</view>
					<text class="move-arrow">›</text>
				</list-item>
				<list-item v-if="filtered.length == 0" class="list-empty">
					<text class="list-empty-text">没有匹配的动作</text>
				</list-item>
			</list-view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { moveGroups, searchMoves, sectionLabel, exetypeLabel } from '@/common/moves.uts'
	import type { Movement, MovementGroup } from '@/common/types.uts'

	const keyword = ref('')
	const category = ref('胸')
	const groups = ref<MovementGroup[]>(moveGroups())
	const filtered = computed<Movement[]>(() : Movement[] => {
		return searchMoves(keyword.value, category.value)
	})

	function selectCategory(key : string) {
		category.value = key
	}

	function clearKeyword() {
		keyword.value = ''
	}

	function openMove(id : string) {
		uni.navigateTo({ url: '/pages/movement/detail?id=' + id })
	}

	function moveSub(m : Movement) : string {
		let muscles = ''
		if (m.primary.length > 0) {
			muscles = m.primary.join(' / ')
		} else {
			muscles = m.category
		}
		return exetypeLabel(m.exetype) + ' · ' + sectionLabel(m.section) + ' · ' + muscles
	}
</script>

